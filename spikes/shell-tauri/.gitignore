# Spike build artifacts — never committed, never packaged.
node_modules/
dist/
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/
sidecar/.venv/
sidecar/dist-onefile/
sidecar/dist-onedir/
sidecar/build-onefile/
sidecar/build-onedir/
sidecar/build-spec/
app-icon.png
measure/out/

# `tauri icon` generates a full mobile/store icon set. tauri.conf.json
# references only 32x32.png, 128x128.png, 128x128@2x.png and icon.ico, and this
# spike builds Windows only — keep the rest out of the tree.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/icon.icns
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
src-tauri/icons/64x64.png
