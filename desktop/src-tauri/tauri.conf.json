{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rigorloom",
  "version": "0.1.0",
  "identifier": "dev.rigorloom.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5184",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rigorloom",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/rigorloomd/**/*"]
  }
}
