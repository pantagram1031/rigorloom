# Build outputs — never committed. Verify with `git status` before every commit.
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# Sidecar build products and the build venv.
sidecar/.venv/
sidecar/build/
sidecar/dist/
sidecar/*.spec
src-tauri/resources/

# Scripted-run scratch: smoke roots, logs, exit-code records, the icon source
# `tauri icon` is fed from.
scripts/_run/

# Mobile icon sets that `tauri icon` regenerates. This is a Windows desktop
# app and neither is built or referenced by tauri.conf.json.
src-tauri/icons/android/
src-tauri/icons/ios/
